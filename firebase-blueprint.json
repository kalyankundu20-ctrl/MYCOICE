{
  "entities": {
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Explicitly registered global administrator UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "active", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Non-PII membership pointer mapping a signed-in user UID to their claimed agency and party role.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "agencyId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "partyId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "role": { "type": "string", "enum": ["admin", "master", "client"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "agencyId", "partyId", "role", "updatedAt"]
    },
    "PartyInvite": {
      "title": "PartyInvite",
      "description": "Unlistable secret invite token resolving a party-wise shareable app link to its agency and role.",
      "type": "object",
      "properties": {
        "accessKey": { "type": "string", "minLength": 16, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "agencyId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "partyId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "partyName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "role": { "type": "string", "enum": ["admin", "master", "client"] },
        "parentMasterId": { "type": "string", "minLength": 0, "maxLength": 128 },
        "parentMasterUid": { "type": "string", "minLength": 0, "maxLength": 128 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "accessKey",
        "agencyId",
        "partyId",
        "partyName",
        "role",
        "parentMasterId",
        "parentMasterUid",
        "ownerUid",
        "createdByUid",
        "active",
        "createdAt",
        "updatedAt"
      ]
    },
    "Agency": {
      "title": "Agency",
      "description": "Shared operational agency state including billing date, config rules, and official winning numbers broadcast to all parties.",
      "type": "object",
      "properties": {
        "agencyId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "adminUids": { "type": "array", "description": "Bounded list (max 10) of admin UIDs for secure list queries." },
        "date": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "limitThreshold": { "type": "number", "description": "Admin per-number ticket limit threshold (default 10)." },
        "sellerLimitThreshold": { "type": "number", "description": "Seller and Sub-Seller per-number ticket limit threshold (default 20)." },
        "excludedPrizeNames": { "type": "array", "description": "Bounded list (max 50) of excluded seller names." },
        "itemOptions": { "type": "array", "description": "Bounded list (max 20) of item multipliers like M5, M10." },
        "winning1PM": { "type": "string", "minLength": 0, "maxLength": 20000 },
        "winning6PM": { "type": "string", "minLength": 0, "maxLength": 20000 },
        "winning8PM": { "type": "string", "minLength": 0, "maxLength": 20000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "agencyId",
        "name",
        "ownerUid",
        "adminUids",
        "date",
        "limitThreshold",
        "excludedPrizeNames",
        "itemOptions",
        "winning1PM",
        "winning6PM",
        "winning8PM",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminPrivateConfig": {
      "title": "AdminPrivateConfig",
      "description": "PII-isolated private admin settings such as WhatsApp dispatch number and extra seller names.",
      "type": "object",
      "properties": {
        "agencyId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "whatsappNumber": { "type": "string", "minLength": 0, "maxLength": 30 },
        "autoArchiveDaily": { "type": "boolean" },
        "pausedAutoArchiveDate": { "type": "string", "minLength": 0, "maxLength": 10 },
        "extraNames": { "type": "array", "description": "Bounded list (max 100) of extra seller names." },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "agencyId",
        "ownerUid",
        "whatsappNumber",
        "autoArchiveDaily",
        "pausedAutoArchiveDate",
        "extraNames",
        "updatedAt"
      ]
    },
    "AgencyMember": {
      "title": "AgencyMember",
      "description": "Authoritative RBAC membership document used by the Master Gate to verify active roles and instant revocation.",
      "type": "object",
      "properties": {
        "agencyId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "partyId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "role": { "type": "string", "enum": ["admin", "master", "client"] },
        "parentMasterId": { "type": "string", "minLength": 0, "maxLength": 128 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "accessKey": { "type": "string", "minLength": 16, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "agencyId",
        "uid",
        "partyId",
        "role",
        "parentMasterId",
        "ownerUid",
        "accessKey",
        "active",
        "createdAt",
        "updatedAt"
      ]
    },
    "Party": {
      "title": "Party",
      "description": "Non-PII Party account (Admin, Master, or Client) with rate, due, joma, link key, and claimed UID.",
      "type": "object",
      "properties": {
        "agencyId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "partyId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "role": { "type": "string", "enum": ["admin", "master", "client"] },
        "parentMasterId": { "type": "string", "minLength": 0, "maxLength": 128 },
        "parentMasterUid": { "type": "string", "minLength": 0, "maxLength": 128 },
        "ancestorMasterIds": { "type": "array", "description": "Optional bounded list (max 10) of all ancestor master partyIds for live multi-level chain sync." },
        "ancestorMasterUids": { "type": "array", "description": "Optional bounded list (max 10) of all ancestor master UIDs for live multi-level chain sync." },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "adminUids": { "type": "array", "description": "Bounded list (max 10) of admin UIDs." },
        "rate": { "type": "number" },
        "due": { "type": "number" },
        "joma": { "type": "number" },
        "active": { "type": "boolean" },
        "accessKey": { "type": "string", "minLength": 16, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "assignedUid": { "type": "string", "minLength": 0, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "agencyId",
        "partyId",
        "name",
        "role",
        "parentMasterId",
        "parentMasterUid",
        "ownerUid",
        "adminUids",
        "rate",
        "due",
        "joma",
        "active",
        "accessKey",
        "assignedUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "PartyPrivate": {
      "title": "PartyPrivate",
      "description": "PII-isolated party contact and credential details (WhatsApp mobile, login ID, login password, and email), restricted to Admin and owning Master.",
      "type": "object",
      "properties": {
        "agencyId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "partyId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "adminUids": { "type": "array", "description": "Bounded list (max 10) of admin UIDs." },
        "parentMasterId": { "type": "string", "minLength": 0, "maxLength": 128 },
        "parentMasterUid": { "type": "string", "minLength": 0, "maxLength": 128 },
        "mobile": { "type": "string", "minLength": 0, "maxLength": 30 },
        "assignedEmail": { "type": "string", "minLength": 0, "maxLength": 120 },
        "loginId": { "type": "string", "minLength": 0, "maxLength": 32, "pattern": "^[a-zA-Z0-9_\\-]*$" },
        "loginPassword": { "type": "string", "minLength": 0, "maxLength": 32 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "agencyId",
        "partyId",
        "ownerUid",
        "adminUids",
        "parentMasterUid",
        "mobile",
        "assignedEmail",
        "updatedAt"
      ]
    },
    "PartySheet": {
      "title": "PartySheet",
      "description": "Isolated per-party 1PM/6PM/8PM ticket entry sheet synced live to the agency Admin and owning Master.",
      "type": "object",
      "properties": {
        "agencyId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "sheetId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "partyId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "partyName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "role": { "type": "string", "enum": ["admin", "master", "client"] },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "adminUids": { "type": "array", "description": "Bounded list (max 10) of admin UIDs." },
        "assignedUid": { "type": "string", "minLength": 0, "maxLength": 128 },
        "parentMasterId": { "type": "string", "minLength": 0, "maxLength": 128 },
        "parentMasterUid": { "type": "string", "minLength": 0, "maxLength": 128 },
        "ancestorMasterIds": { "type": "array", "description": "Optional bounded list (max 10) of all ancestor master partyIds for live multi-level chain sync." },
        "ancestorMasterUids": { "type": "array", "description": "Optional bounded list (max 10) of all ancestor master UIDs for live multi-level chain sync." },
        "date": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "entries1PM": { "type": "array", "description": "Bounded list (max 500) of 1PM TicketEntryRow objects." },
        "entries6PM": { "type": "array", "description": "Bounded list (max 500) of 6PM TicketEntryRow objects." },
        "entries8PM": { "type": "array", "description": "Bounded list (max 500) of 8PM TicketEntryRow objects." },
        "updatedByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "agencyId",
        "sheetId",
        "partyId",
        "partyName",
        "role",
        "ownerUid",
        "adminUids",
        "assignedUid",
        "parentMasterId",
        "parentMasterUid",
        "date",
        "entries1PM",
        "entries6PM",
        "entries8PM",
        "updatedByUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "ArchiveSnapshot": {
      "title": "ArchiveSnapshot",
      "description": "Admin-only archived daily snapshot of agency bills, prizes, and entries.",
      "type": "object",
      "properties": {
        "agencyId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "snapshotId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "adminUids": { "type": "array", "description": "Bounded list (max 10) of admin UIDs." },
        "date": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "savedAt": { "type": "string", "minLength": 1, "maxLength": 64 },
        "trigger": { "type": "string", "enum": ["manual", "daily-auto", "day-close"] },
        "payload": { "type": "object", "description": "Structured DaySnapshot map." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "agencyId",
        "snapshotId",
        "ownerUid",
        "adminUids",
        "date",
        "savedAt",
        "trigger",
        "payload",
        "createdAt",
        "updatedAt"
      ]
    },
    "PartyArchiveSnapshot": {
      "title": "PartyArchiveSnapshot",
      "description": "Per-party isolated daily archive snapshot accessible to the owning Master, Sub-Master, or Sub-Seller and Agency Admin.",
      "type": "object",
      "properties": {
        "agencyId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "snapshotId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "partyId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "partyName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "adminUids": { "type": "array", "description": "Bounded list (max 10) of admin UIDs." },
        "assignedUid": { "type": "string", "minLength": 0, "maxLength": 128 },
        "parentMasterId": { "type": "string", "minLength": 0, "maxLength": 128 },
        "parentMasterUid": { "type": "string", "minLength": 0, "maxLength": 128 },
        "date": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "savedAt": { "type": "string", "minLength": 1, "maxLength": 64 },
        "trigger": { "type": "string", "enum": ["manual", "daily-auto", "day-close"] },
        "payload": { "type": "object", "description": "Structured non-PII DaySnapshot map for this party." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "agencyId",
        "snapshotId",
        "partyId",
        "partyName",
        "ownerUid",
        "adminUids",
        "assignedUid",
        "parentMasterId",
        "parentMasterUid",
        "date",
        "savedAt",
        "trigger",
        "payload",
        "createdAt",
        "updatedAt"
      ]
    },
    "PublicAnnouncement": {
      "title": "PublicAnnouncement",
      "description": "Zero-PII public agency advertisement, special offer, or urgent message published by Admin and readable on the login link, installed app, and all Master/Sub-Master/Sub-Seller portals.",
      "type": "object",
      "properties": {
        "agencyId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "active": { "type": "boolean" },
        "kind": { "type": "string", "enum": ["offer", "urgent", "notice"] },
        "title": { "type": "string", "minLength": 0, "maxLength": 120 },
        "message": { "type": "string", "minLength": 0, "maxLength": 1000 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "updatedByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "agencyId",
        "active",
        "kind",
        "title",
        "message",
        "ownerUid",
        "updatedByUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminLedgerChunk": {
      "title": "AdminLedgerChunk",
      "description": "Admin-only chunked backup of full 1PM, 6PM, and 8PM ledger entries (up to 800 rows per chunk, supporting 30,000+ rows safely under Firestore 1MB limit).",
      "type": "object",
      "properties": {
        "agencyId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "chunkId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "sessionId": { "type": "string", "enum": ["1PM", "6PM", "8PM"] },
        "chunkIndex": { "type": "number" },
        "totalChunks": { "type": "number" },
        "date": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "revisionMs": { "type": "number" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "adminUids": { "type": "array", "description": "Bounded list (max 10) of admin UIDs." },
        "rows": { "type": "array", "description": "Bounded list (max 1000) of TicketEntryRow objects in this chunk." },
        "updatedByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "agencyId",
        "chunkId",
        "sessionId",
        "chunkIndex",
        "totalChunks",
        "date",
        "revisionMs",
        "ownerUid",
        "adminUids",
        "rows",
        "updatedByUid",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Explicitly registered global admin accounts."
    },
    "/userProfiles/{uid}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Self-owned pointer resolving a user's active agency and party."
    },
    "/partyInvites/{accessKey}": {
      "schema": { "$ref": "#/entities/PartyInvite" },
      "description": "Unlistable secret invite links mapping accessKey to party metadata."
    },
    "/publicAnnouncements/{agencyId}": {
      "schema": { "$ref": "#/entities/PublicAnnouncement" },
      "description": "Zero-PII public agency advertisement, offer, or urgent notice readable on app/link and all portals, writable strictly by verified Agency Admin."
    },
    "/agencies/{agencyId}": {
      "schema": { "$ref": "#/entities/Agency" },
      "description": "Agency operational state and official winning lists."
    },
    "/agencies/{agencyId}/private/{configId}": {
      "schema": { "$ref": "#/entities/AdminPrivateConfig" },
      "description": "PII-isolated admin private settings."
    },
    "/agencies/{agencyId}/members/{memberUid}": {
      "schema": { "$ref": "#/entities/AgencyMember" },
      "description": "Authoritative RBAC membership records for Master Gate."
    },
    "/agencies/{agencyId}/parties/{partyId}": {
      "schema": { "$ref": "#/entities/Party" },
      "description": "Non-PII party accounts (Admin, Master, Client)."
    },
    "/agencies/{agencyId}/partyPrivate/{partyId}": {
      "schema": { "$ref": "#/entities/PartyPrivate" },
      "description": "PII-isolated party mobile numbers and claimed emails."
    },
    "/agencies/{agencyId}/sheets/{sheetId}": {
      "schema": { "$ref": "#/entities/PartySheet" },
      "description": "Per-party live 1PM/6PM/8PM entry sheets."
    },
    "/agencies/{agencyId}/archives/{snapshotId}": {
      "schema": { "$ref": "#/entities/ArchiveSnapshot" },
      "description": "Admin-only daily archive snapshots."
    },
    "/agencies/{agencyId}/partyArchives/{snapshotId}": {
      "schema": { "$ref": "#/entities/PartyArchiveSnapshot" },
      "description": "Per-party isolated daily archive snapshots for Masters, Sub-Masters, and Sub-Sellers."
    },
    "/agencies/{agencyId}/adminLedgerChunks/{chunkId}": {
      "schema": { "$ref": "#/entities/AdminLedgerChunk" },
      "description": "Admin-only permanent chunked cloud backup of all 1PM, 6PM, and 8PM ledger rows."
    }
  }
}
